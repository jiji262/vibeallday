{
  "name": "@vibeallday/client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/run-with-safe-home.js vite",
    "dev:remote": "node ../../scripts/run-with-safe-home.js vite --config vite.config.remote.ts",
    "build": "tsc && vite build",
    "build:stable": "tsc && vite build --base /_stable/ --outDir dist-stable",
    "build:remote": "tsc && vite build --config vite.config.remote.ts",
    "preview:remote": "vite preview --config vite.config.remote.ts",
    "mockup:dev": "vite --config vite.config.mockup.ts",
    "mockup:build": "tsc -p tsconfig.mockups.json && vite build --config vite.config.mockup.ts",
    "mockup:export": "pnpm mockup:build && playwright test --config playwright.mockups.config.ts",
    "test": "node ../../scripts/run-with-safe-home.js vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "request:census": "node scripts/request-census.mjs",
    "transcript:artifacts": "node scripts/transcript-artifact-smoke.mjs",
    "transcript:benchmark": "tsx scripts/transcript-projection-benchmark.ts",
    "benchmark:version-snapshot": "tsx scripts/version-snapshot-benchmark.ts",
    "benchmark:project-queue-backstop": "tsx scripts/project-queue-backstop-benchmark.ts",
    "benchmark:query-revalidation-owner": "tsx scripts/query-revalidation-owner-benchmark.ts",
    "benchmark:forced-refetch-staleness": "tsx scripts/forced-refetch-staleness-benchmark.ts",
    "benchmark:global-sessions-feed-owner": "tsx scripts/global-sessions-feed-owner-benchmark.ts",
    "benchmark:reload-status-fanout": "tsx scripts/reload-status-fanout-benchmark.ts",
    "benchmark:reload-status-shared-snapshot": "tsx scripts/reload-status-shared-snapshot-benchmark.ts",
    "benchmark:query-bootstrap-order": "tsx scripts/query-bootstrap-order-benchmark.ts",
    "benchmark:global-sessions-conditional-read": "tsx scripts/global-sessions-conditional-read-benchmark.ts"
  },
  "dependencies": {
    "@vibeallday/shared": "workspace:*",
    "katex": "^0.18.6",
    "mermaid": "^11.17.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.15.1",
    "tssrp6a": "^3.0.0",
    "tweetnacl": "^1.0.3",
    "uqr": "^0.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/react": "^16.1.0",
    "@types/hast": "^3.0.4",
    "@types/node": "^22.19.15",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
