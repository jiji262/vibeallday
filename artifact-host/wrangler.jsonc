{
  "name": "vibeallday-artifact-host",
  "main": ".generated/index.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "node build.mjs" },
  "routes": [
    {
      "pattern": "*.vibeallday.navs.dpdns.org/*",
      "zone_name": "vibeallday.navs.dpdns.org"
    }
  ],
  "observability": { "enabled": false }
}
