{
    admin off
    auto_https off
}

:8080 {
    @asset path /assets/*
    handle @asset {
        root * /srv
        @missing not file
        handle @missing {
            header Cache-Control "no-store"
            respond 404
        }
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /srv/current
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}
